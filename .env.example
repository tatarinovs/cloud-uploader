# ==============================================================================
# Cloud Uploader - Конфигурация окружения (.env)
# Скопируйте этот файл в .env и укажите ваши данные
# ==============================================================================

# Общие настройки по умолчанию (можно переопределить через ключи -p и -r)
CLOUD_PROVIDER=yandex
CLOUD_REMOTE_DIR=/Upload

# ------------------------------------------------------------------------------
# 1. Яндекс.Диск
# Токен OAuth (https://oauth.yandex.ru/ с правами на Яндекс.Диск REST API)
# ------------------------------------------------------------------------------
YANDEX_TOKEN=y0__your_yandex_oauth_token_here

# ------------------------------------------------------------------------------
# 2. Облако Mail.ru (WebDAV)
# Email и пароль для внешних приложений (Настройки -> Безопасность -> Пароли для приложений)
# ------------------------------------------------------------------------------
MAILRU_USER=your_email@mail.ru
MAILRU_PASSWORD=your_mailru_app_password

# ------------------------------------------------------------------------------
# 3. Google Drive (Google Drive API v3)
# OAuth2 Access Token (https://developers.google.com/oauthplayground или gcloud auth print-access-token)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_TOKEN=ya29.your_google_access_token_here

# ------------------------------------------------------------------------------
# 4. S3 / Cloudflare R2 / MinIO / Yandex Cloud Object Storage
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=my-backups
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=auto

# ------------------------------------------------------------------------------
# 5. Универсальный WebDAV (Nextcloud, ownCloud, pCloud, Synology NAS)
# ------------------------------------------------------------------------------
WEBDAV_URL=https://nextcloud.example.com/remote.php/dav/files/user/
WEBDAV_USER=your_webdav_username
WEBDAV_PASSWORD=your_webdav_app_password

# ------------------------------------------------------------------------------
# 6. GitHub API (Опционально)
# Personal Access Token для снятия лимита 60 запросов/час при зеркалировании релизов
# ------------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_your_github_token_here
