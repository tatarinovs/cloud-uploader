# ==============================================================================
# Cloud Uploader - конфигурация окружения (.env)
# Скопируйте этот файл в .env рядом с программой и укажите свои данные.
# Переменные окружения системы имеют приоритет над значениями из .env.
# ==============================================================================

# Общие настройки по умолчанию (переопределяются ключами командной строки)
CLOUD_PROVIDER=yandex
CLOUD_REMOTE_DIR=/Upload
# CLOUD_JOBS=2                 # параллельные загрузки (-j)
# CLOUD_URLS_FILE=urls.txt     # список ссылок (--urls-file)
# CLOUD_ASSET_FILTER=(?i)\.(apk|exe|zip|tar\.gz)$   # какие файлы релизов скачивать (--assets)
# CLOUD_UPLOADER_LOG=debug     # уровень логирования в синтаксисе tracing

# ------------------------------------------------------------------------------
# 1. Яндекс.Диск — OAuth-токен с доступом к REST API Диска (https://oauth.yandex.ru/)
# ------------------------------------------------------------------------------
YANDEX_TOKEN=y0__your_yandex_oauth_token_here

# ------------------------------------------------------------------------------
# 2. Облако Mail.ru (WebDAV) — e-mail и пароль для внешних приложений
#    (Настройки -> Безопасность -> Пароли для внешних приложений)
# ------------------------------------------------------------------------------
MAILRU_USER=your_email@mail.ru
MAILRU_PASSWORD=your_mailru_app_password
# MAILRU_WEBDAV_URL=https://webdav.mail.ru

# ------------------------------------------------------------------------------
# 3. Google Drive (API v3)
#    Рекомендуется: OAuth-клиент + refresh token — токены обновляются автоматически.
#    Альтернатива: GOOGLE_DRIVE_TOKEN — access token, живёт ~1 час.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=1//your_refresh_token
# GOOGLE_DRIVE_TOKEN=ya29.your_access_token

# ------------------------------------------------------------------------------
# 4. S3 / Cloudflare R2 / MinIO / Yandex Object Storage (path-style запросы)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=my-backups
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
# Регион подписи: R2 — auto, AWS — регион бакета, Yandex — ru-central1. По умолчанию us-east-1.
S3_REGION=auto

# ------------------------------------------------------------------------------
# 5. Универсальный WebDAV (Nextcloud, ownCloud, Synology NAS и др.)
# ------------------------------------------------------------------------------
WEBDAV_URL=https://nextcloud.example.com/remote.php/dav/files/user/
WEBDAV_USER=your_webdav_username
WEBDAV_PASSWORD=your_webdav_app_password
# true, только если ETag сервера — это MD5 содержимого файла (бывает редко)
# WEBDAV_ETAG_IS_MD5=false

# ------------------------------------------------------------------------------
# 6. GitHub API (опционально) — снимает лимит 60 запросов/час при зеркалировании
# ------------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_your_github_token_here
